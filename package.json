{
  "name": "codex-project-sessions",
  "displayName": "Codex · Project Sessions",
  "description": "Organize local Codex history by project, with search, favorites, and custom names.",
  "version": "0.1.1",
  "publisher": "samuel-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandessamuel21-lang/codex-project-sessions.git"
  },
  "homepage": "https://github.com/fernandessamuel21-lang/codex-project-sessions#readme",
  "bugs": {
    "url": "https://github.com/fernandessamuel21-lang/codex-project-sessions/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:codexSessions.list"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSessions",
          "title": "Codex Sessions",
          "icon": "resources/sessions.svg"
        }
      ]
    },
    "views": {
      "codexSessions": [
        {
          "id": "codexSessions.list",
          "name": "Project Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "codexSessions.refresh",
        "title": "Refresh Sessions",
        "category": "Codex Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "codexSessions.search",
        "title": "Search Sessions",
        "category": "Codex Sessions",
        "icon": "$(search)"
      },
      {
        "command": "codexSessions.scope",
        "title": "Toggle Current Project / All Projects",
        "category": "Codex Sessions",
        "icon": "$(folder-library)"
      },
      {
        "command": "codexSessions.open",
        "title": "Open in Codex",
        "category": "Codex Sessions"
      },
      {
        "command": "codexSessions.terminal",
        "title": "Resume in Terminal",
        "category": "Codex Sessions"
      },
      {
        "command": "codexSessions.rename",
        "title": "Rename Session",
        "category": "Codex Sessions"
      },
      {
        "command": "codexSessions.favorite",
        "title": "Toggle Favorite",
        "category": "Codex Sessions",
        "icon": "$(star-empty)"
      },
      {
        "command": "codexSessions.copyId",
        "title": "Copy Session ID",
        "category": "Codex Sessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexSessions.search",
          "when": "view == codexSessions.list",
          "group": "navigation@1"
        },
        {
          "command": "codexSessions.scope",
          "when": "view == codexSessions.list",
          "group": "navigation@2"
        },
        {
          "command": "codexSessions.refresh",
          "when": "view == codexSessions.list",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "codexSessions.favorite",
          "when": "view == codexSessions.list && viewItem == session",
          "group": "inline"
        },
        {
          "command": "codexSessions.open",
          "when": "viewItem == session",
          "group": "1_open"
        },
        {
          "command": "codexSessions.terminal",
          "when": "viewItem == session",
          "group": "1_open"
        },
        {
          "command": "codexSessions.rename",
          "when": "viewItem == session",
          "group": "2_manage"
        },
        {
          "command": "codexSessions.copyId",
          "when": "viewItem == session",
          "group": "2_manage"
        }
      ]
    },
    "configuration": {
      "title": "Codex Sessions",
      "properties": {
        "codexSessions.codexHome": {
          "type": "string",
          "default": "",
          "description": "History directory. Leave empty to use CODEX_HOME or ~/.codex.",
          "scope": "machine"
        },
        "codexSessions.cliPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable used to resume sessions in the terminal.",
          "scope": "machine"
        }
      }
    }
  }
}
